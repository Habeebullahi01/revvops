# ---- Supabase (required) ----
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_, never commit the real value.
# Used only for admin operations (e.g. creating user accounts in Phase 3).
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Workshop branding (print layouts: job card A4 / receipt) ----
NEXT_PUBLIC_WORKSHOP_NAME=
NEXT_PUBLIC_WORKSHOP_ADDRESS=
NEXT_PUBLIC_WORKSHOP_PHONE=
# Path to logo file in /public, e.g. /logo.png
NEXT_PUBLIC_WORKSHOP_LOGO=
